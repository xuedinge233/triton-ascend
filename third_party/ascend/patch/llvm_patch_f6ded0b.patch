 /// Return if operations should be printed in the generic form.
-bool OpPrintingFlags::shouldPrintGenericOpForm() const {
-  return printGenericOpFormFlag;
+static bool needsBishengIRGenericForm(Operation *op) {
+  if (!op)
+    return false;
+  StringRef name = op->getName().getStringRef();
+  // Explicit types in generic assembly preserve layouts, memory spaces and
+  // access contracts without changing LLVM 22 bufferization operations.
+  if (name == "bufferization.to_tensor")
+    return op->getNumOperands() == 1 && op->getNumResults() == 1 &&
+           isa<BaseMemRefType>(op->getOperand(0).getType()) &&
+           isa<TensorType>(op->getResult(0).getType());
+  if (name == "bufferization.to_buffer")
+    return op->getNumOperands() == 1 && op->getNumResults() == 1 &&
+           isa<TensorType>(op->getOperand(0).getType()) &&
+           isa<BaseMemRefType>(op->getResult(0).getType());
+  return name == "arith.trunci" || name == "cf.cond_br" ||
+         name == "llvm.load" || name == "llvm.store" ||
+         name == "llvm.inttoptr" || name == "llvm.intr.assume";
+}
+
+static OperandRange getBishengIROperands(Operation *op) {
+  auto operands = op->getOperands();
+  if (op->getName().getStringRef() == "llvm.intr.assume" && !operands.empty())
+    return operands.take_front(1);
+  return operands;
+}
+
+static NamedAttrList getBishengIRAttrs(Operation *op) {
+  StringRef name = op->getName().getStringRef();
+  NamedAttrList attrs(op->getAttrs());
+  // These facts only restrict originally defined executions or guide
+  // optimization. Omitting them is conservative; never drop semantic
+  // properties such as unsignedCmp, indexing_maps or tail_call_kind.
+  if (name == "arith.trunci")
+    attrs.erase("overflowFlags");
+  if (name == "cf.cond_br")
+    attrs.erase("branch_weights");
+  if (name == "llvm.load" || name == "llvm.store" || name == "llvm.inttoptr") {
+    attrs.erase("dereferenceable");
+    attrs.erase("invariantGroup");
+  }
+  if (name == "llvm.intr.assume") {
+    attrs.erase("op_bundle_tags");
+    attrs.set("op_bundle_sizes", DenseI32ArrayAttr::get(op->getContext(), {}));
+  }
+  return attrs;
+}
+
+bool OpPrintingFlags::shouldPrintGenericOpForm(Operation *op) const {
+  return printGenericOpFormFlag ||
+         (printBishengIRCompatFlag && needsBishengIRGenericForm(op));
 }
 
